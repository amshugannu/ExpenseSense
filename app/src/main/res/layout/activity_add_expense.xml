<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".AddExpenseActivity">

    <!-- 1.  HEADER IMAGE -->
    <ImageView
        android:id="@+id/imgHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:adjustViewBounds="true"
        android:contentDescription="Header background"
        android:scaleType="fitXY"
        android:src="@drawable/activityheaderbg" />

    <!--HEADER CONTROLS-->
    <RelativeLayout
        android:id="@+id/headerControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/imgHeader"
        android:layout_alignBottom="@id/imgHeader">

        <!-- Back arrow -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentStart="true"
            android:layout_marginStart="8dp"
            android:layout_marginTop="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_back_arrow"
            app:tint="#FFFFFF" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="56dp"
            android:text="Add Expense"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold|italic"
            android:letterSpacing="0.02" />

        <!-- Three-dot menu -->
        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="48dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="More options"
            android:src="@drawable/ic_dots_menu"
            app:tint="#FFFFFF" />

    </RelativeLayout>

    <!--3.  ADD EXPENSE BUTTON -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddExpense"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="28dp"
        android:elevation="12dp"
        android:outlineAmbientShadowColor="@color/color_teal_primary"
        android:outlineSpotShadowColor="@color/color_teal_primary"
        android:text="Add Expense"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:translationZ="4dp"
        app:backgroundTint="@color/color_teal_primary"
        app:cornerRadius="30dp"
        app:elevation="8dp"
        tools:targetApi="p"
        xmlns:tools="http://schemas.android.com/tools" />

    <!--  4.  SCROLLABLE FORM -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/btnAddExpense"
        android:layout_below="@id/imgHeader"
        android:layout_marginTop="-120dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- ── PARENT FORM CARD ─────────────────────────────────── -->
            
            <androidx.cardview.widget.CardView
                android:id="@+id/cardForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="10dp"
                app:cardUseCompatPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="22dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="26dp">

                    <!-- ┌─ TRANSACTION TYPE ──────────────────────────┐ -->
                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        app:singleSelection="true"
                        app:selectionRequired="true"
                        app:checkedButton="@+id/btnTypeExpense">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTypeExpense"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Expense"
                            android:textAllCaps="false"
                            android:textColor="@color/black"
                            app:strokeColor="#EEEEEE"
                            app:rippleColor="#FDECEC"
                            app:backgroundTint="@color/white" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTypeIncome"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Income"
                            android:textAllCaps="false"
                            android:textColor="@color/black"
                            app:strokeColor="#EEEEEE"
                            app:rippleColor="#ECFDFD"
                            app:backgroundTint="@color/white" />

                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <!-- ┌─ CATEGORY & NAME ───────────────────────────┐ -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.12"
                        android:text="NAME"
                        android:textAllCaps="true"
                        android:textColor="#AAAAAA"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Category Selector -->
                        <RelativeLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp">

                            <androidx.cardview.widget.CardView
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                app:cardCornerRadius="8dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="#F5F5F5">

                                <ImageView
                                    android:id="@+id/ivCategoryIcon"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_gravity="center"
                                    android:scaleType="centerCrop" />
                            </androidx.cardview.widget.CardView>

                            <ProgressBar
                                android:id="@+id/pbCategorySelect"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_centerInParent="true"
                                android:elevation="2dp"
                                android:visibility="gone" />
                        </RelativeLayout>

                        <!-- Name Field -->
                        <RelativeLayout
                            android:layout_width="0dp"
                            android:layout_height="60dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_field_normal"
                            android:paddingStart="14dp"
                            android:paddingEnd="12dp">

                            <EditText
                                android:id="@+id/etName"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@null"
                                android:hint="Expense Name"
                                android:imeOptions="actionNext"
                                android:inputType="textCapWords"
                                android:paddingEnd="4dp"
                                android:textColor="#2C2C2C"
                                android:textColorHint="#C5C5C5"
                                android:textSize="15sp" />
                        </RelativeLayout>
                    </LinearLayout>
                    <!-- └─────────────────────────────────────────────┘ -->

                    <!-- ┌─ AMOUNT ────────────────────────────────────┐ -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:letterSpacing="0.12"
                        android:text="AMOUNT"
                        android:textAllCaps="true"
                        android:textColor="#AAAAAA"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_field_teal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <EditText
                            android:id="@+id/etAmount"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_toStartOf="@+id/tvClear"
                            android:background="@null"
                            android:hint="₹ 0.00"
                            android:imeOptions="actionNext"
                            android:inputType="numberDecimal"
                            android:paddingEnd="4dp"
                            android:textColor="#2ABFBF"
                            android:textColorHint="#A8DEDE"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvClear"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingStart="8dp"
                            android:text="Clear"
                            android:textColor="#2ABFBF"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </RelativeLayout>
                    <!-- └─────────────────────────────────────────────┘ -->

                    <!-- ┌─ DATE ──────────────────────────────────────┐ -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:letterSpacing="0.12"
                        android:text="DATE"
                        android:textAllCaps="true"
                        android:textColor="#AAAAAA"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <RelativeLayout
                        android:id="@+id/layoutDate"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_field_normal"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <TextView
                            android:id="@+id/tvDate"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_toStartOf="@+id/ivCalendar"
                            android:gravity="center_vertical"
                            android:hint="Select Date"
                            android:paddingEnd="4dp"
                            android:textColor="#2C2C2C"
                            android:textColorHint="#C5C5C5"
                            android:textSize="15sp" />

                        <ImageView
                            android:id="@+id/ivCalendar"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:contentDescription="Pick date"
                            android:src="@drawable/ic_calendar"
                            app:tint="#BBBBBB" />
                    </RelativeLayout>
                    <!-- └─────────────────────────────────────────────┘ -->

                    <!-- ┌─ TIME ──────────────────────────────────────┐ -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:letterSpacing="0.12"
                        android:text="TIME"
                        android:textAllCaps="true"
                        android:textColor="#AAAAAA"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <RelativeLayout
                        android:id="@+id/layoutTime"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_field_normal"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <TextView
                            android:id="@+id/tvTime"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_toStartOf="@+id/ivClock"
                            android:gravity="center_vertical"
                            android:hint="Select Time"
                            android:paddingEnd="4dp"
                            android:textColor="#2C2C2C"
                            android:textColorHint="#C5C5C5"
                            android:textSize="15sp" />

                        <ImageView
                            android:id="@+id/ivClock"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:contentDescription="Pick time"
                            android:src="@drawable/ic_time"
                            app:tint="#BBBBBB" />
                    </RelativeLayout>
                    <!-- └─────────────────────────────────────────────┘ -->

                    <!-- ┌─ PAYMENT METHOD ──────────────────────────────┐ -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:letterSpacing="0.12"
                        android:text="PAYMENT METHOD"
                        android:textAllCaps="true"
                        android:textColor="#AAAAAA"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupPaymentMethod"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:singleSelection="true"
                        app:selectionRequired="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCash"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cash"
                            android:checked="true"
                            app:chipBackgroundColor="@color/bg_chip_state_list"
                            app:chipStrokeWidth="0dp"
                            app:rippleColor="#2ABFBF" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipUPI"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="UPI"
                            app:chipBackgroundColor="@color/bg_chip_state_list"
                            app:chipStrokeWidth="0dp"
                            app:rippleColor="#2ABFBF" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipDebit"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Debit Card"
                            app:chipBackgroundColor="@color/bg_chip_state_list"
                            app:chipStrokeWidth="0dp"
                            app:rippleColor="#2ABFBF" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCredit"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Credit Card"
                            app:chipBackgroundColor="@color/bg_chip_state_list"
                            app:chipStrokeWidth="0dp"
                            app:rippleColor="#2ABFBF" />
                    </com.google.android.material.chip.ChipGroup>
                    <!-- └─────────────────────────────────────────────┘ -->

                    <!-- ┌─ DYNAMIC SELECTOR (BANK/CARD) ──────────────┐ -->
                    <LinearLayout
                        android:id="@+id/layoutDynamicSelector"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvSelectorLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:letterSpacing="0.12"
                            android:text="SELECT BANK"
                            android:textAllCaps="true"
                            android:textColor="#AAAAAA"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/spinnerDynamic"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_field_normal"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp" />
                    </LinearLayout>
                    <!-- └─────────────────────────────────────────────┘ -->

                    <!-- ┌─ NOTE ──────────────────────────────────────┐ -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:letterSpacing="0.12"
                        android:text="NOTE (OPTIONAL)"
                        android:textAllCaps="true"
                        android:textColor="#AAAAAA"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etNote"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_field_normal"
                        android:hint="Add a note"
                        android:inputType="text"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="#2C2C2C"
                        android:textColorHint="#C5C5C5"
                        android:textSize="15sp" />
                    <!-- └─────────────────────────────────────────────┘ -->

                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <!-- ── END FORM CARD ──────────────────────────────────────── -->

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
